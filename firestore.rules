rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /matches/{code} {
      allow read, write: if true;
      match /m/{seat} { allow read, write: if true; }
    }
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /presence/{id} {
      allow read, write: if true;
    }
  }
}
